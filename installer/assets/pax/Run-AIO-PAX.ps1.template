#Requires -Version 7.0
<#
.SYNOPSIS
    Refreshes the AI in One data with PAX, then puts the files where the report reads them.

.DESCRIPTION
    Written by the AI in One installer from your install record. Don't edit it: running the
    installer again writes it afresh. The scheduled task "AI in One - PAX refresh" runs it daily.

    The first run (the seed) loads the history. Each later run loads the last few days and appends
    them to the local Interactions file. PAX drops the rows the file already has, so days that
    overlap aren't counted twice. When PAX finishes, the files are uploaded to the SharePoint
    folder (or copied to the local folder) under fixed names, so the report always finds them.

.PARAMETER Seed
    Load the history again, replacing the local files. The installer's "run --backfill-days"
    command asks the scheduled task for this by leaving a seed.request file in the state folder.

.PARAMETER CheckAccess
    Don't run PAX. Check that the app can reach the SharePoint library and write to the folder,
    and print what it found as one line that starts with AIO-RESULT.
#>
[CmdletBinding()]
param(
    [switch]$Seed,
    [switch]$CheckAccess
)

Set-StrictMode -Version 3.0
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

# {{SETTINGS}}

$DataDir = Join-Path $Settings.StateDir 'data'
$LogDir = Join-Path $Settings.StateDir 'logs'
$PaxLogDir = Join-Path $LogDir 'pax'
$WorkDir = Join-Path $Settings.StateDir 'work'
foreach ($dir in @($DataDir, $LogDir, $PaxLogDir, $WorkDir)) { $null = New-Item -ItemType Directory -Force -Path $dir }

$Stamp = (Get-Date).ToString('yyyyMMdd-HHmmss')
$RunLog = Join-Path $LogDir "run-$Stamp.log"
$LastRunFile = Join-Path $LogDir 'last-run.json'
$SeedRequest = Join-Path $Settings.StateDir 'seed.request'
$KeepLogs = 30
$SimpleUploadLimit = 250MB
$ChunkSize = 320KB * 16
$Streams = @(
    [pscustomobject]@{ Name = 'Interactions'; File = 'AIO_Interactions.csv'; Pattern = '*_Interactions.csv'; Wanted = $true }
    [pscustomobject]@{ Name = 'Users'; File = 'AIO_Users.csv'; Pattern = '*_Users.csv'; Wanted = $true }
    [pscustomobject]@{ Name = 'Agent365'; File = 'AIO_Agent365.csv'; Pattern = 'Agent365_*.csv'; Wanted = [bool]$Settings.Agent365 }
)

$Result = [ordered]@{
    startedAt   = (Get-Date).ToUniversalTime().ToString('o')
    finishedAt  = $null
    status      = 'running'
    mode        = $null
    exitCode    = $null
    attempts    = 0
    paxVersion  = $Settings.PaxVersion
    destination = $Settings.Destination
    files       = @()
    metrics     = $null
    log         = $RunLog
    warnings    = @()
    message     = $null
}

function Write-RunLog {
    param([string]$Message, [ValidateSet('INFO', 'WARN', 'ERROR')][string]$Level = 'INFO')
    $line = '{0} [{1}] {2}' -f (Get-Date).ToString('s'), $Level, $Message
    Add-Content -LiteralPath $RunLog -Value $line -Encoding utf8
    Write-Information $line -InformationAction Continue
    if ($Level -eq 'WARN') { $Result.warnings += $Message }
}

# Written when a run starts, so the installer can tell one is under way, and again when it ends.
function Save-Result {
    if ($Result.status -ne 'running') { $Result.finishedAt = (Get-Date).ToUniversalTime().ToString('o') }
    $Result | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $LastRunFile -Encoding utf8
}

function Clear-WorkDir {
    Get-ChildItem -LiteralPath $WorkDir -Force -ErrorAction SilentlyContinue |
        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
}

# Daily runs append to copies of the files, so a run that fails leaves the files as they were.
# PAX also keeps its scratch files beside the file it appends to, which is the work folder.
function Initialize-WorkDir([string]$Mode) {
    Clear-WorkDir
    if ($Mode -ne 'daily') { return }
    foreach ($s in @($Streams | Where-Object Wanted)) {
        $stable = Join-Path $DataDir $s.File
        if (Test-Path -LiteralPath $stable) { Copy-Item -LiteralPath $stable -Destination (Join-Path $WorkDir $s.File) -Force }
    }
}

function Remove-OldFiles([string]$Dir, [string]$Filter) {
    Get-ChildItem -LiteralPath $Dir -Filter $Filter -File -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending | Select-Object -Skip $KeepLogs |
        Remove-Item -Force -ErrorAction SilentlyContinue
}

function Get-HttpStatus($ErrorRecord) {
    $ex = $ErrorRecord.Exception
    if ($ex.PSObject.Properties['Response'] -and $ex.Response) { return [int]$ex.Response.StatusCode }
    return 0
}

# Retries throttling and server errors, waiting longer each time.
function Invoke-Graph([string]$What, [scriptblock]$Call) {
    for ($attempt = 1; ; $attempt++) {
        try {
            return & $Call
        } catch {
            $status = Get-HttpStatus $_
            if ($attempt -ge 4 -or ($status -ne 429 -and $status -lt 500)) { throw }
            $wait = [int][math]::Min(120, 15 * $attempt)
            Write-RunLog "$What got HTTP $status. Trying again in $wait seconds."
            Start-Sleep -Seconds $wait
        }
    }
}

function ConvertTo-Base64Url([byte[]]$Bytes) {
    [Convert]::ToBase64String($Bytes).TrimEnd('=').Replace('+', '-').Replace('/', '_')
}

# PowerShell 7 reads ISO times in JSON as dates, so they go back out in one fixed form.
function ConvertTo-IsoTime($Value) {
    if ($Value -is [datetime]) { return $Value.ToUniversalTime().ToString('o') }
    if ($Value -is [datetimeoffset]) { return $Value.UtcDateTime.ToString('o') }
    if ($null -eq $Value) { return $null }
    [string]$Value
}

function Get-RunCertificate {
    $path = 'Cert:\CurrentUser\My\' + $Settings.CertificateThumbprint
    if (-not (Test-Path -LiteralPath $path)) {
        throw "The certificate $($Settings.CertificateThumbprint) isn't in your personal certificate store. Run the installer again to make a new one."
    }
    Get-Item -LiteralPath $path
}

function Get-ClientSecretText {
    if (-not (Test-Path -LiteralPath $Settings.SecretFile)) {
        throw "The protected client secret is missing. Run the installer again to repair it."
    }
    $protected = (Get-Content -LiteralPath $Settings.SecretFile -Raw).Trim()
    [System.Net.NetworkCredential]::new('', (ConvertTo-SecureString -String $protected)).Password
}

# An app-only token for Microsoft Graph: a signed client assertion with the certificate, or the secret.
function Get-GraphToken {
    $uri = 'https://login.microsoftonline.com/{0}/oauth2/v2.0/token' -f $Settings.TenantId
    $body = @{
        client_id  = $Settings.ClientId
        scope      = 'https://graph.microsoft.com/.default'
        grant_type = 'client_credentials'
    }
    if ($Settings.CredentialType -eq 'secret') {
        $body.client_secret = Get-ClientSecretText
    } else {
        $cert = Get-RunCertificate
        $rsa = [System.Security.Cryptography.X509Certificates.RSACertificateExtensions]::GetRSAPrivateKey($cert)
        if (-not $rsa) { throw "Can't use the private key of certificate $($Settings.CertificateThumbprint)." }
        $now = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
        $header = [ordered]@{ alg = 'RS256'; typ = 'JWT'; x5t = (ConvertTo-Base64Url $cert.GetCertHash()) } | ConvertTo-Json -Compress
        $claims = [ordered]@{
            aud = $uri
            iss = $Settings.ClientId
            sub = $Settings.ClientId
            jti = [guid]::NewGuid().ToString()
            nbf = $now - 60
            exp = $now + 600
        } | ConvertTo-Json -Compress
        $unsigned = (ConvertTo-Base64Url ([Text.Encoding]::UTF8.GetBytes($header))) + '.' + (ConvertTo-Base64Url ([Text.Encoding]::UTF8.GetBytes($claims)))
        $signature = $rsa.SignData([Text.Encoding]::UTF8.GetBytes($unsigned), [Security.Cryptography.HashAlgorithmName]::SHA256, [Security.Cryptography.RSASignaturePadding]::Pkcs1)
        $body.client_assertion_type = 'urn:ietf:params:oauth:client-assertion-type:jwt-bearer'
        $body.client_assertion = $unsigned + '.' + (ConvertTo-Base64Url $signature)
    }
    $response = Invoke-Graph 'Signing in' { Invoke-RestMethod -Method Post -Uri $uri -Body $body -ContentType 'application/x-www-form-urlencoded' }
    $response.access_token
}

function Get-AuthHeader {
    @{ Authorization = 'Bearer ' + $script:Token }
}

# Path-based addressing in the one library the app can write to: no search, nothing tenant-wide.
function Get-DriveItemUri([string]$Name, [string]$Action) {
    $segments = @(($Settings.Folder -split '/') | Where-Object { $_ }) + @($Name)
    $path = ($segments | ForEach-Object { [uri]::EscapeDataString($_) }) -join '/'
    if (-not $Action) { return 'https://graph.microsoft.com/v1.0/drives/{0}/root:/{1}' -f $Settings.DriveId, $path }
    'https://graph.microsoft.com/v1.0/drives/{0}/root:/{1}:/{2}' -f $Settings.DriveId, $path, $Action
}

# What -CheckAccess does, with the app's own access to the one site: finds the site by its path
# and the library by its name, makes the folder, writes and deletes a small file, then lists the
# data files that are there.
function Test-SiteAccess {
    $step = 'Signing in as the app'
    if ($Settings.Destination -ne 'sharepoint') {
        $out = [ordered]@{ ok = $false; step = 'Checking the settings'; status = 0; error = 'The files go to a local folder, so there is no SharePoint access to check.' }
        return 'AIO-RESULT ' + ($out | ConvertTo-Json -Compress -EscapeHandling EscapeNonAscii)
    }
    try {
        $script:Token = Get-GraphToken
        $step = 'Finding the site'
        $sitePath = @(($Settings.SitePath -split '/') | Where-Object { $_ } | ForEach-Object { [uri]::EscapeDataString($_) }) -join '/'
        $siteUri = if ($sitePath) { 'https://graph.microsoft.com/v1.0/sites/{0}:/{1}' -f $Settings.SiteHost, $sitePath } else { 'https://graph.microsoft.com/v1.0/sites/{0}' -f $Settings.SiteHost }
        $site = Invoke-Graph $step { Invoke-RestMethod -Uri $siteUri -Headers (Get-AuthHeader) }
        $step = 'Finding the library'
        $drives = Invoke-Graph $step { Invoke-RestMethod -Uri ('https://graph.microsoft.com/v1.0/sites/{0}/drives' -f $site.id) -Headers (Get-AuthHeader) }
        $drive = @($drives.value | Where-Object {
                $_.name -eq $Settings.Library -or [uri]::UnescapeDataString(($_.webUrl -split '/')[-1]) -eq $Settings.Library
            }) | Select-Object -First 1
        if (-not $drive) {
            $names = (@($drives.value) | ForEach-Object { $_.name }) -join ', '
            throw "The site has no library called $($Settings.Library). Its libraries: $names."
        }
        $Settings.DriveId = $drive.id
        $step = 'Making the folder'
        $parent = ''
        foreach ($segment in @(($Settings.Folder -split '/') | Where-Object { $_ })) {
            $children = if ($parent) { 'https://graph.microsoft.com/v1.0/drives/{0}/root:/{1}:/children' -f $drive.id, $parent } else { 'https://graph.microsoft.com/v1.0/drives/{0}/root/children' -f $drive.id }
            $body = @{ name = $segment; folder = @{}; '@microsoft.graph.conflictBehavior' = 'fail' } | ConvertTo-Json -Compress
            try {
                $null = Invoke-Graph $step { Invoke-RestMethod -Method Post -Uri $children -Headers (Get-AuthHeader) -ContentType 'application/json' -Body $body }
            } catch {
                if ((Get-HttpStatus $_) -ne 409) { throw }
            }
            $escaped = [uri]::EscapeDataString($segment)
            $parent = if ($parent) { $parent + '/' + $escaped } else { $escaped }
        }
        $step = 'Writing a test file'
        $probe = Join-Path $WorkDir 'aio-access-check.txt'
        Set-Content -LiteralPath $probe -Value ('AI in One checked its access at {0}.' -f (Get-Date).ToUniversalTime().ToString('o')) -Encoding utf8
        $null = Invoke-Graph $step { Invoke-RestMethod -Method Put -Uri (Get-DriveItemUri 'aio-access-check.txt' 'content') -Headers (Get-AuthHeader) -InFile $probe -ContentType 'text/plain' }
        $step = 'Deleting the test file'
        $null = Invoke-Graph $step { Invoke-RestMethod -Method Delete -Uri (Get-DriveItemUri 'aio-access-check.txt' '') -Headers (Get-AuthHeader) }
        Remove-Item -LiteralPath $probe -Force -ErrorAction SilentlyContinue
        $step = 'Listing the files'
        $files = @(foreach ($s in @($Streams | Where-Object Wanted)) {
                try {
                    $item = Invoke-Graph $step { Invoke-RestMethod -Uri (Get-DriveItemUri $s.File '') -Headers (Get-AuthHeader) }
                    [ordered]@{ name = $s.File; exists = $true; size = [long]$item.size; lastModified = (ConvertTo-IsoTime $item.lastModifiedDateTime); webUrl = $item.webUrl }
                } catch {
                    if ((Get-HttpStatus $_) -ne 404) { throw }
                    [ordered]@{ name = $s.File; exists = $false }
                }
            })
        $out = [ordered]@{
            ok          = $true
            siteId      = $site.id
            siteName    = $site.displayName
            siteWebUrl  = $site.webUrl
            driveId     = $drive.id
            driveName   = $drive.name
            driveWebUrl = $drive.webUrl
            folder      = $Settings.Folder
            files       = $files
        }
    } catch {
        $out = [ordered]@{ ok = $false; step = $step; status = (Get-HttpStatus $_); error = $_.Exception.Message }
    }
    # In the console's code page, so a site or library name that isn't ASCII is escaped.
    'AIO-RESULT ' + ($out | ConvertTo-Json -Compress -EscapeHandling EscapeNonAscii)
}

function Receive-RemoteFile([string]$Name, [string]$Target) {
    try {
        $null = Invoke-Graph "Downloading $Name" {
            Invoke-WebRequest -Uri (Get-DriveItemUri $Name 'content') -Headers (Get-AuthHeader) -OutFile $Target
        }
        return $true
    } catch {
        if ((Get-HttpStatus $_) -eq 404) { return $false }
        throw
    }
}

function Send-RemoteFile([string]$Path, [string]$Name) {
    $size = (Get-Item -LiteralPath $Path).Length
    if ($size -le $SimpleUploadLimit) {
        # A simple upload first: some tenants refuse upload sessions.
        $null = Invoke-Graph "Uploading $Name" {
            Invoke-RestMethod -Method Put -Uri (Get-DriveItemUri $Name 'content') -Headers (Get-AuthHeader) -InFile $Path -ContentType 'text/csv'
        }
        return
    }
    $session = Invoke-Graph "Starting the upload of $Name" {
        Invoke-RestMethod -Method Post -Uri (Get-DriveItemUri $Name 'createUploadSession') -Headers (Get-AuthHeader) -ContentType 'application/json' -Body '{"item":{"@microsoft.graph.conflictBehavior":"replace"}}'
    }
    $stream = [System.IO.File]::OpenRead($Path)
    try {
        $buffer = [byte[]]::new($ChunkSize)
        $offset = [long]0
        while ($offset -lt $size) {
            $read = $stream.Read($buffer, 0, $buffer.Length)
            if ($read -le 0) { throw "Couldn't read $Path." }
            $chunk = [byte[]]::new($read)
            [Array]::Copy($buffer, $chunk, $read)
            $range = 'bytes {0}-{1}/{2}' -f $offset, ($offset + $read - 1), $size
            # The upload URL carries its own authorisation, so it gets no token.
            $null = Invoke-Graph "Uploading $Name" {
                Invoke-RestMethod -Method Put -Uri $session.uploadUrl -Headers @{ 'Content-Range' = $range } -Body $chunk -ContentType 'application/octet-stream'
            }
            $offset += $read
        }
    } finally {
        $stream.Dispose()
    }
}

function Invoke-Pax([string]$Mode, [switch]$AutoCompleteness) {
    $Result.attempts++
    $metrics = Join-Path $LogDir ('pax-metrics-{0}-{1}.json' -f $Stamp, $Result.attempts)
    $today = (Get-Date).ToUniversalTime().Date
    $days = if ($Mode -eq 'seed') { [int]$Settings.SeedDays } else { [int]$Settings.WindowDays }
    $paxArgs = @{
        Auth             = 'AppRegistration'
        TenantId         = $Settings.TenantId
        ClientId         = $Settings.ClientId
        StartDate        = $today.AddDays(-$days).ToString('yyyy-MM-dd')
        EndDate          = $today.ToString('yyyy-MM-dd')
        Rollup           = $true
        SkipVersionCheck = $true
        EmitMetricsJson  = $true
        MetricsPath      = $metrics
        OutputPathLog    = $PaxLogDir
    }
    if ($Settings.CredentialType -eq 'secret') {
        $paxArgs.ClientSecret = Get-ClientSecretText
    } else {
        $paxArgs.ClientCertificateThumbprint = $Settings.CertificateThumbprint
        $paxArgs.ClientCertificateStoreLocation = 'CurrentUser'
    }
    if ($AutoCompleteness) { $paxArgs.AutoCompleteness = $true }
    # Each stream appends to its copy in the work folder when there is one, or else is written
    # fresh to the work folder. PAX takes one or the other for each stream, never both.
    foreach ($s in @($Streams | Where-Object Wanted)) {
        $copy = Join-Path $WorkDir $s.File
        $append = $Mode -eq 'daily' -and (Test-Path -LiteralPath $copy)
        switch ($s.Name) {
            'Interactions' { if ($append) { $paxArgs.AppendFile = $copy } else { $paxArgs.OutputPath = $WorkDir } }
            'Users' { if ($append) { $paxArgs.AppendUserInfo = $copy } else { $paxArgs.IncludeUserInfo = $true; $paxArgs.OutputPathUserInfo = $WorkDir } }
            'Agent365' { if ($append) { $paxArgs.AppendAgent365Info = $copy } else { $paxArgs.IncludeAgent365Info = $true; $paxArgs.OutputPathAgent365Info = $WorkDir } }
        }
    }
    $extra = if ($AutoCompleteness) { ', with -AutoCompleteness' } else { '' }
    Write-RunLog ('Running PAX {0}: {1} run, {2} to {3}{4}.' -f $Settings.PaxVersion, $Mode, $paxArgs.StartDate, $paxArgs.EndDate, $extra)
    $code = 0
    # Nobody is at the keyboard, even when the task runs while you're signed in, so PAX mustn't prompt.
    $env:PAX_NONINTERACTIVE = '1'
    Push-Location -LiteralPath $WorkDir
    try {
        # PAX runs as it does on its own: without this script's strict mode, and errors that
        # don't stop it are logged rather than thrown.
        $code = & {
            Set-StrictMode -Off
            $ErrorActionPreference = 'Continue'
            $global:LASTEXITCODE = 0
            & $Settings.PaxScript @paxArgs *>> $RunLog
            [int]$global:LASTEXITCODE
        }
    } catch {
        Write-RunLog "PAX stopped: $($_.Exception.Message)" 'ERROR'
        $code = if ($LASTEXITCODE) { [int]$LASTEXITCODE } else { 1 }
    } finally {
        Pop-Location
    }
    if (Test-Path -LiteralPath $metrics) { $Result.metrics = $metrics }
    Write-RunLog "PAX finished with exit code $code."
    return $code
}

# Gives the files this run wrote their fixed names in the data folder. A seed run keeps the file
# it replaces as a .previous.csv file.
function Save-NewOutput([string]$Mode) {
    foreach ($s in @($Streams | Where-Object Wanted)) {
        $stable = Join-Path $DataDir $s.File
        $copy = Join-Path $WorkDir $s.File
        $new = if ($Mode -eq 'daily' -and (Test-Path -LiteralPath $copy)) {
            Get-Item -LiteralPath $copy
        } else {
            Get-ChildItem -LiteralPath $WorkDir -Filter $s.Pattern -File -ErrorAction SilentlyContinue |
                Where-Object Name -ne $s.File | Sort-Object LastWriteTime -Descending | Select-Object -First 1
        }
        if (-not $new) { continue }
        if ($Mode -eq 'seed' -and (Test-Path -LiteralPath $stable)) {
            $previous = Join-Path $DataDir ([IO.Path]::GetFileNameWithoutExtension($s.File) + '.previous.csv')
            Move-Item -LiteralPath $stable -Destination $previous -Force
        }
        Move-Item -LiteralPath $new.FullName -Destination $stable -Force
        Write-RunLog "Saved $($s.File)."
    }
}

function Publish-Files {
    foreach ($s in @($Streams | Where-Object Wanted)) {
        $path = Join-Path $DataDir $s.File
        if (-not (Test-Path -LiteralPath $path)) {
            Write-RunLog "PAX didn't write $($s.File) this time." 'WARN'
            continue
        }
        if ($Settings.Destination -eq 'sharepoint') {
            Send-RemoteFile $path $s.File
            Write-RunLog "Uploaded $($s.File) to the SharePoint folder $($Settings.Folder)."
        } else {
            $null = New-Item -ItemType Directory -Force -Path $Settings.LocalFolder
            Copy-Item -LiteralPath $path -Destination (Join-Path $Settings.LocalFolder $s.File) -Force
            Write-RunLog "Copied $($s.File) to $($Settings.LocalFolder)."
        }
        $Result.files += $s.File
    }
}

if ($CheckAccess) {
    Test-SiteAccess
    exit 0
}

$exitCode = 0
try {
    Write-RunLog "AI in One PAX refresh started. Installer version $($Settings.InstallerVersion)."
    Save-Result
    if (-not (Test-Path -LiteralPath $Settings.PaxScript)) { throw "PAX isn't at $($Settings.PaxScript). Run the installer again to repair it." }
    $hash = (Get-FileHash -LiteralPath $Settings.PaxScript -Algorithm SHA256).Hash
    if ($hash -ne $Settings.PaxSha256) { throw "PAX at $($Settings.PaxScript) has changed (SHA-256 $hash), so it wasn't run. Run the installer again to repair it." }
    if ($Settings.Destination -eq 'sharepoint' -and -not $Settings.DriveId) { throw "The installer hasn't checked the SharePoint library yet. Run the installer again to repair it." }
    # PAX looks for Python on PATH, and installs one itself, silently, when it finds none. Put the
    # one the installer checked first, and stop rather than let PAX install another.
    if (-not $Settings.PythonDir -or -not (Test-Path -LiteralPath (Join-Path $Settings.PythonDir 'python.exe'))) {
        throw "Python isn't in $($Settings.PythonDir) any more. Run the installer again to repair it."
    }
    $env:PATH = $Settings.PythonDir + [IO.Path]::PathSeparator + $env:PATH

    $credential = if ($Settings.CredentialType -eq 'secret') { 'client secret' } else { 'certificate' }
    $expires = if ($Settings.CredentialType -ne 'secret') {
        (Get-RunCertificate).NotAfter.ToUniversalTime()
    } elseif ($Settings.SecretExpires) {
        [datetimeoffset]::Parse($Settings.SecretExpires, [Globalization.CultureInfo]::InvariantCulture).UtcDateTime
    } else { $null }
    if ($expires) {
        $daysLeft = [int][math]::Floor(($expires - (Get-Date).ToUniversalTime()).TotalDays)
        if ($daysLeft -lt 30) { Write-RunLog "The task's $credential expires in $daysLeft days. Run the installer again on this PC to renew it." 'WARN' }
    }

    $interactions = Join-Path $DataDir 'AIO_Interactions.csv'
    $seedRequested = $Seed -or (Test-Path -LiteralPath $SeedRequest)
    if ($Settings.Destination -eq 'sharepoint') {
        $script:Token = Get-GraphToken
        # A new PC, or lost local files: start from the SharePoint copies, so no history is lost.
        if (-not $seedRequested) {
            foreach ($s in @($Streams | Where-Object Wanted)) {
                $local = Join-Path $DataDir $s.File
                if (-not (Test-Path -LiteralPath $local) -and (Receive-RemoteFile $s.File $local)) {
                    Write-RunLog "Downloaded $($s.File) from SharePoint to append to it."
                }
            }
        }
    }

    $mode = if ($seedRequested -or -not (Test-Path -LiteralPath $interactions)) { 'seed' } else { 'daily' }
    $Result.mode = $mode
    Save-Result
    Initialize-WorkDir $mode
    $code = Invoke-Pax $mode
    if ($code -eq 10) {
        Write-RunLog 'PAX reported an incomplete load (exit code 10). Running it once more with -AutoCompleteness.' 'WARN'
        Initialize-WorkDir $mode
        $code = Invoke-Pax $mode -AutoCompleteness
    }
    $Result.exitCode = $code
    if ($code -ne 0) {
        $meaning = switch ($code) {
            10 { 'some days hit the audit search limit, so the load is incomplete' }
            20 { 'Microsoft Graph kept refusing requests, so PAX stopped early' }
            30 { "PAX couldn't read the users from Microsoft Entra" }
            40 { 'parts of the load failed, so PAX left the files as they were' }
            default { 'PAX stopped with an error' }
        }
        throw "PAX exited with code $code ($meaning), so nothing was published. See $RunLog and the PAX log in $PaxLogDir."
    }

    # PAX doesn't append to a file an older PAX made. It leaves the file as it was, writes this
    # run's rows to a file of their own, and still exits 0.
    if ($mode -eq 'daily' -and @(Get-ChildItem -LiteralPath $WorkDir -Filter '*_Interactions_*.csv' -File -ErrorAction SilentlyContinue).Count) {
        Write-RunLog "PAX didn't add this run's days to AIO_Interactions.csv, because an older PAX made the file. To load the history again, run the installer's run command with --backfill-days $([int]$Settings.SeedDays)." 'WARN'
    }
    Save-NewOutput $mode
    if ($Settings.Destination -eq 'sharepoint') { $script:Token = Get-GraphToken }
    Publish-Files
    if ($mode -eq 'seed') { Remove-Item -LiteralPath $SeedRequest -Force -ErrorAction SilentlyContinue }
    $Result.status = if (@($Result.warnings).Count) { 'warning' } else { 'ok' }
    $Result.message = "Published $(@($Result.files).Count) files."
    Write-RunLog 'Done.'
} catch {
    $Result.status = 'failed'
    $Result.message = $_.Exception.Message
    Write-RunLog $_.Exception.Message 'ERROR'
    $exitCode = if ($Result.exitCode) { [int]$Result.exitCode } else { 1 }
} finally {
    Clear-WorkDir
    Remove-OldFiles $LogDir 'run-*.log'
    Remove-OldFiles $LogDir 'pax-metrics-*.json'
    Remove-OldFiles $PaxLogDir '*'
    Save-Result
}
exit $exitCode
